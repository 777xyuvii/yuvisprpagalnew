local _fbIdToken = nil
local _fbTokenExpiry = 0

local function fbSignIn()
    local res = rawRequest({
        Url = "https://identitytoolkit.googleapis.com/v1/accounts:signUp?key="..FIREBASE_WEB_API_KEY,
        Method = "POST",
        Headers = {["Content-Type"]="application/json"},
        Body = '{"returnSecureToken":true}',
    })
    if not res or not res.Body then return false end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
    if not ok or type(data)~="table" or not data.idToken then return false end
    _fbIdToken = data.idToken
    _fbTokenExpiry = os.time() + 3300
    return true
end

pcall(fbSignIn)

local function fbReq(opts)
    if type(opts)=="table" and type(opts.Url)=="string" and opts.Url:find("firebaseio%.com") then
        if not _fbIdToken or os.time() >= _fbTokenExpiry then pcall(fbSignIn) end
        if _fbIdToken then
            opts.Url = opts.Url..(opts.Url:find("?") and "&" or "?").."auth=".._fbIdToken
        end
    end
    return rawRequest(opts)
end

