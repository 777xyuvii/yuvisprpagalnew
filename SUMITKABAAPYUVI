local function broadcastPayload(text, isMusic, musicId)
    if FIREBASE_URL == "" then return end
    task.spawn(function()
        local data = {
            sender = Player.Name,
            text = text,
            isMusic = isMusic or false,
            musicId = musicId or "",
            timestamp = os.time()
        }
        local success, json = pcall(function() return HttpSvc:JSONEncode(data) end)
        if success then
            makeHttpRequest({
                Url = FIREBASE_URL .. "global_chat.json",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = json
            })
        end
    end)
end

