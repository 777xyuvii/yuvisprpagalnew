                local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if ok and type(data) == "table" then
                    for _, cmd in pairs(data) do
                        if cmd and tonumber(cmd.targetUid) == RealUserId and cmd.action == "kick" then
                            LocalPlayer:Kick("You have been kicked from Devta Chat.")
                        end
                    end
                end
            end
        end)
    end
end)

