local function playSoundCloud(query)
    task.spawn(function()
        local searchUrl = "https://api-v2.soundcloud.com/search/tracks?q=" .. HttpService:UrlEncode(query) .. "&client_id=" .. SC_CLIENT_ID .. "&limit=1"
        local res = sendRequest({Url = searchUrl, Method = "GET"})
        if not res or res.StatusCode ~= 200 then
            addMessage("SYSTEM", "Music search failed!", true, false)
            return
        end
        local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if not ok or not data.collection or #data.collection == 0 then
            addMessage("SYSTEM", "Song not found!", true, false)
            return
        end
        local track = data.collection[1]
        local streamUrl = nil
        for _, tc in ipairs(track.media.transcodings) do
            if tc.format.protocol == "progressive" then
                local sRes = sendRequest({Url = tc.url .. "?client_id=" .. SC_CLIENT_ID, Method = "GET"})
                if sRes and sRes.StatusCode == 200 then
                    local sOk, sData = pcall(function() return HttpService:JSONDecode(sRes.Body) end)
                    if sOk and sData.url then
                        streamUrl = sData.url
                        break
                    end
                end
            end
        end
        if streamUrl and writefile and getcustomasset then
            local dlRes = sendRequest({Url = streamUrl, Method = "GET"})
            if dlRes and dlRes.Body then
                writefile("devta_music.mp3", dlRes.Body)
                task.wait(0.2)
                local customAsset = getcustomasset("devta_music.mp3")
                if activeSound then activeSound:Destroy() end
                activeSound = Instance.new("Sound", SoundService)
                activeSound.SoundId = customAsset
                activeSound.Volume = 0.5
                activeSound:Play()
                addMessage("SYSTEM", "Playing: " .. track.title, true, false)
            end
        else
            addMessage("SYSTEM", "Executor does not support custom audio asset loading!", true, false)
        end
    end)
end

