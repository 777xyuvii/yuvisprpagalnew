-- Helper function to push message to Firebase
local function postMessageToDB(text, pvtRecipient)
    local data = {
        sender = RealDisplayName,
        senderId = RealUserId,
        text = text,
        targetRecipient = pvtRecipient or "",
        timestamp = os.time()
    }
    local success, encoded = pcall(function() return HttpService:JSONEncode(data) end)
    if success then
        task.spawn(function()
            sendRequest({
                Url = DATABASE_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = encoded
            })
        end)
    end
end

-- Send Message & Command Logic (!give, !spm, !kick)
local function sendMessage(text)
    text = text:gsub("^%s+", ""):gsub("%s+$", "")
    if text == "" then return end
    
    -- Check for Commands
    if string.sub(text, 1, 1) == "!" then
        local parts = string.split(text, " ")
        local cmd = string.lower(parts[1])
        
        -- !give command (Admin Rights)
        if cmd == "!give" then
            if MyPanelAccess or string.lower(RealName) == "yuvi" or string.lower(RealName) == "sneaky_gmr" then
                local targetName = parts[2]
                local dur = tonumber(parts[3]) or 86400
                if targetName then
                    local found = false
                    for _, p in pairs(Players:GetPlayers()) do
                        if string.lower(p.Name) == string.lower(targetName) or string.lower(p.DisplayName) == string.lower(targetName) then
                            giveAccess(p.UserId, p.Name, dur)
                            addMessage("SYSTEM", "Admin access granted to " .. p.DisplayName .. " for " .. dur .. "s", true, false)
                            found = true
                            break
                        end
                    end
                    if not found then addMessage("SYSTEM", "Player not found in server!", true, false) end
                end
            else
                addMessage("SYSTEM", "Only Owner (YUVI) or Admins can use !give", true, false)
            end
            return
        end

        -- !spm command (Spam Flooding)
        if cmd == "!spm" then
            if MyPanelAccess or string.lower(RealName) == "yuvi" or string.lower(RealName) == "sneaky_gmr" then
                local rawContent = text:sub(5)
                local splitData = string.split(rawContent, "~")
                local msgToSpam = splitData[1] and splitData[1]:gsub("^%s+", ""):gsub("%s+$", "") or "Spam"
                local count = splitData[2] and tonumber(splitData[2]) or 10
                count = math.clamp(count, 1, 50)

                addMessage("SYSTEM", "Starting Spam Flood (" .. count .. "x)...", true, false)
                task.spawn(function()
                    for i = 1, count do
                        postMessageToDB(msgToSpam, targetPrivateUser)
                        addMessage(RealDisplayName, msgToSpam, false, targetPrivateUser ~= nil)
                        task.wait(0.15)
                    end
                end)
            else
                addMessage("SYSTEM", "Only Owner (YUVI) or Admins can use !spm", true, false)
            end
            return
        end

        -- !kick command (Kick Player)
        if cmd == "!kick" then
            if MyPanelAccess or string.lower(RealName) == "yuvi" or string.lower(RealName) == "sneaky_gmr" then
                local targetName = parts[2]
                if targetName then
                    targetName = targetName:gsub("@", "")
                    local foundPlayer = nil
                    for _, p in pairs(Players:GetPlayers()) do
                        if string.lower(p.Name) == string.lower(targetName) or string.lower(p.DisplayName) == string.lower(targetName) then
                            foundPlayer = p
                            break
                        end
                    end
                    if foundPlayer then
                        if foundPlayer ~= LocalPlayer then
                            addMessage("SYSTEM", "Kicking player: " .. foundPlayer.Name, true, false)
                            pcall(function()
                                sendRequest({
                                    Url = FB_BASE .. "/cmds.json",
                                    Method = "POST",
                                    Headers = {["Content-Type"] = "application/json"},
                                    Body = HttpService:JSONEncode({targetUid = foundPlayer.UserId, action = "kick", time = os.time()})
                                })
                            end)
                            foundPlayer:Kick("You have been kicked from Devta Chat.")
                        else
                            addMessage("SYSTEM", "You cannot kick yourself!", true, false)
                        end
                    else
                        addMessage("SYSTEM", "Player not found in server!", true, false)
                    end
                end
            else
                addMessage("SYSTEM", "Only Owner (YUVI) or Admins can use !kick", true, false)
            end
            return
        end
    end

    -- Normal or Private DM Message Broadcast
    addMessage(RealDisplayName, text, false, targetPrivateUser ~= nil)
    postMessageToDB(text, targetPrivateUser)
end

