-- 1. CHAT SECTION (Asli working UI chat box)
local function loadChatSection()
    clearContent()
    
    -- Chat History Display Box
    local chatScroll = Instance.new("ScrollingFrame")
    chatScroll.Size = UDim2.new(1, -20, 1, -70)
    chatScroll.Position = UDim2.new(0, 10, 0, 10)
    chatScroll.BackgroundTransparency = 1
    chatScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    chatScroll.ScrollBarThickness = 4
    chatScroll.Parent = contentArea
    
    local chatList = Instance.new("UIListLayout")
    chatList.SortOrder = Enum.SortOrder.LayoutOrder
    chatList.Padding = UDim.new(0, 5)
    chatList.Parent = chatScroll
    
    -- Text Input Box to type message
    local textBox = Instance.new("TextBox")
    textBox.Size = UDim2.new(1, -90, 0, 40)
    textBox.Position = UDim2.new(0, 10, 1, -50)
    textBox.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    textBox.PlaceholderText = "Yahan message type karein..."
    textBox.Text = ""
    textBox.TextSize = 14
    textBox.Font = Enum.Font.SourceSans
    textBox.ClearTextOnFocus = false
    textBox.Parent = contentArea
    
    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 6)
    boxCorner.Parent = textBox
    
    -- Send Button
    local sendBtn = Instance.new("TextButton")
    sendBtn.Size = UDim2.new(0, 70, 0, 40)
    sendBtn.Position = UDim2.new(1, -80, 1, -50)
    sendBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    sendBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    sendBtn.Text = "Send"
    sendBtn.TextSize = 15
    sendBtn.Font = Enum.Font.SourceSansBold
    sendBtn.Parent = contentArea
    
    local sendCorner = Instance.new("UICorner")
    sendCorner.CornerRadius = UDim.new(0, 6)
    sendCorner.Parent = sendBtn
    
    -- Function to add message to UI chat box
    local function addMessage(senderName, msgText)
        local msgLabel = Instance.new("TextLabel")
        msgLabel.Size = UDim2.new(1, 0, 0, 25)
        msgLabel.BackgroundTransparency = 1
        msgLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
        msgLabel.TextSize = 14
        msgLabel.Font = Enum.Font.SourceSans
        msgLabel.TextXAlignment = Enum.TextXAlignment.Left
        msgLabel.TextWrapped = true
        msgLabel.Text = "[" .. senderName .. "]: " .. msgText
        msgLabel.Parent = chatScroll
        
        chatScroll.CanvasSize = UDim2.new(0, 0, 0, chatList.AbsoluteContentSize.Y)
    end
    
    -- Send message logic (Ye game ki normal chat mein bhi bhejega aur UI me bhi dikhayega)
    local function sendMessage()
        if textBox.Text ~= "" then
            local textToSend = textBox.Text
            textBox.Text = ""
            
            -- Send to actual Roblox Game Chat if possible
            pcall(function()
                local TextChatService = game:GetService("TextChatService")
                if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                    local channels = TextChatService.TextChannels:FindFirstChild("RBXGeneral")
                    if channels then
                        channels:SendAsync(textToSend)
                    end
                else
                    game:GetService("ReplicatedStorage"):FindFirstChild("DefaultChatSystemChatEvents"):FindFirstChild("SayMessageRequest"):FireServer(textToSend, "All")
                end
            end)
            
            addMessage(player.Name, textToSend)
        end
    end
    
    sendBtn.MouseButton1Click:Connect(sendMessage)
    textBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            sendMessage()
        end
    end)
    
    -- Listen to incoming player chats in the game
    for _, p in ipairs(Players:GetPlayers()) do
        p.Chatted:Connect(function(msg)
            addMessage(p.Name, msg)
        end)
    end
    
    Players.PlayerAdded:Connect(function(newPlayer)
        newPlayer.Chatted:Connect(function(msg)
            addMessage(newPlayer.Name, msg)
        end)
    end)
end

