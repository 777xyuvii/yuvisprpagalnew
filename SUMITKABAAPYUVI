local function send(msg)
    msg = tostring(msg or ""):gsub("^%s+", ""):gsub("%s+$", "")
    if msg == "" then return end

    -- Command Handler (!give command)
    if string.sub(msg, 1, 1) == "!" or string.sub(msg, 1, 1) == "/" then
        local parts = string.split(msg, " ")
        local cmd = string.lower(parts[1])

        if cmd == "!give" or cmd == "/give" then
            if isOwner or MyPanelAccess then
                local targetName = parts[2]
                local dur = tonumber(parts[3]) or 86400
                if targetName then
                    for _, p in pairs(Players:GetPlayers()) do
                        if string.lower(p.Name) == string.lower(targetName) or string.lower(p.DisplayName) == string.lower(targetName) then
                            givePanelAccess(p.UserId, p.Name, dur)
                            addMessage("SYSTEM", "✅ Admin rights given to "..p.DisplayName.." for "..dur.."s", true)
                            return
                        end
                    end
                    addMessage("SYSTEM", "❌ Player not found!", true)
                end
            else
                addMessage("SYSTEM", "❌ Only Owner (YUVI) can use !give", true)
            end
            return
        end
    end

    addMessage(RealDisplayName, msg, false)
    task.spawn(function()
        pcall(function()
            local timestamp = string.format("%012d", os.time())..math.random(100, 999)
            fbReq({
                Url = DATABASE_URL.."/"..timestamp..".json",
                Method = "PUT",
                Headers = {["Content-Type"]="application/json"},
                Body = HttpService:JSONEncode({
                    Sender = RealDisplayName,
                    SenderUid = RealUserId,
                    Content = msg,
                    Server = JobId,
                    IsSystem = false
                })
            })
        end)
    end)
end

