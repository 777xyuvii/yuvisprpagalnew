-- 1. CHAT SECTION (Avatar Circle + Name + Message Box)
local function loadChatSection()
    clearContent()
    
    local chatScroll = Instance.new("ScrollingFrame")
    chatScroll.Size = UDim2.new(1, -20, 1, -70)
    chatScroll.Position = UDim2.new(0, 10, 0, 10)
    chatScroll.BackgroundTransparency = 1
    chatScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    chatScroll.ScrollBarThickness = 4
    chatScroll.Parent = contentArea
    
    local chatList = Instance.new("UIListLayout")
    chatList.SortOrder = Enum.SortOrder.LayoutOrder
    chatList.Padding = UDim.new(0, 8)
    chatList.Parent = chatScroll
    
    local textBox = Instance.new("TextBox")
    textBox.Size = UDim2.new(1, -90, 0, 40)
    textBox.Position = UDim2.new(0, 10, 1, -50)
    textBox.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    textBox.PlaceholderText = "PVT MSG TYPE HERE..."
    textBox.Text = ""
    textBox.TextSize = 14
    textBox.Font = Enum.Font.SourceSans
    textBox.ClearTextOnFocus = false
    textBox.Parent = contentArea
    
    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 6)
    boxCorner.Parent = textBox
    
    local sendBtn = Instance.new("TextButton")
    sendBtn.Size = UDim2.new(0, 70, 0, 40)
    sendBtn.Position = UDim2.new(1, -80, 1, -50)
    sendBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
    sendBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    sendBtn.Text = "Send"
    sendBtn.TextSize = 15
    sendBtn.Font = Enum.Font.SourceSansBold
    sendBtn.Parent = contentArea
    
    local sendCorner = Instance.new("UICorner")
    sendCorner.CornerRadius = UDim.new(0, 6)
    sendCorner.Parent = sendBtn
    
    local function addChatMessage(senderName, senderUserId, msgText)
        local msgContainer = Instance.new("Frame")
        msgContainer.Size = UDim2.new(1, 0, 0, 45)
        msgContainer.BackgroundTransparency = 1
        msgContainer.Parent = chatScroll
        
        local avatarImg = Instance.new("ImageLabel")
        avatarImg.Size = UDim2.new(0, 38, 0, 38)
        avatarImg.Position = UDim2.new(0, 0, 0, 3)
        avatarImg.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
        avatarImg.Image = Players:GetUserThumbnailAsync(senderUserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size42x42)
        avatarImg.Parent = msgContainer
        
        local avatarCorner = Instance.new("UICorner")
        avatarCorner.CornerRadius = UDim.new(1, 0)
        avatarCorner.Parent = avatarImg
        
        local textHolder = Instance.new("Frame")
        textHolder.Size = UDim2.new(1, -48, 1, 0)
        textHolder.Position = UDim2.new(0, 48, 0, 0)
        textHolder.BackgroundTransparency = 1
        textHolder.Parent = msgContainer
        
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 0, 18)
        nameLabel.BackgroundTransparency = 1
        nameLabel.TextColor3 = Color3.fromRGB(0, 170, 255)
        nameLabel.TextSize = 14
        nameLabel.Font = Enum.Font.SourceSansBold
        nameLabel.TextXAlignment = Enum.TextXAlignment.Left
        nameLabel.Text = senderName
        nameLabel.Parent = textHolder
        
        local msgLabel = Instance.new("TextLabel")
        msgLabel.Size = UDim2.new(1, 0, 0, 24)
        msgLabel.Position = UDim2.new(0, 0, 0, 18)
        msgLabel.BackgroundTransparency = 1
        msgLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
        msgLabel.TextSize = 14
        msgLabel.Font = Enum.Font.SourceSans
        msgLabel.TextXAlignment = Enum.TextXAlignment.Left
        msgLabel.TextWrapped = true
        msgLabel.Text = msgText
        msgLabel.Parent = textHolder
        
        chatScroll.CanvasSize = UDim2.new(0, 0, 0, chatList.AbsoluteContentSize.Y + 10)
    end
    
    local function sendMessage()
        if textBox.Text ~= "" then
            local textToSend = textBox.Text
            textBox.Text = ""
            chatEvent:Fire(player.Name, player.UserId, textToSend)
        end
    end
    
    sendBtn.MouseButton1Click:Connect(sendMessage)
    textBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            sendMessage()
        end
    end)
    
    local connection
    connection = chatEvent.Event:Connect(function(sName, sUserId, sText)
        if chatScroll and chatScroll.Parent then
            addChatMessage(sName, sUserId, sText)
        else
            connection:Disconnect()
        end
    end)
end

