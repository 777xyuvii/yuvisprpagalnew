-- ============================================================
-- PANEL ACCESS (!give command support)
-- ============================================================
local PanelAccess = {}
local MyPanelAccess = false

local function loadPanelAccess()
    pcall(function()
        local res = fbReq({Url = ACCESS_URL..".json", Method="GET"})
        if res and res.Body and res.Body ~= "null" then
            local ok, data = pcall(HttpService.JSONDecode, HttpService, res.Body)
            if ok and type(data) == "table" then
                local now = os.time()
                for uidStr, entry in pairs(data) do
                    local uid = tonumber(uidStr)
                    if uid and type(entry) == "table" and entry.expiresAt then
                        if entry.expiresAt > now then
                            PanelAccess[uid] = entry.expiresAt
                        else
                            task.spawn(function()
                                pcall(function()
                                    fbReq({Url = ACCESS_URL.."/"..uidStr..".json", Method = "DELETE"})
                                end)
                            end)
                        end
                    end
                end
            end
        end
    end)
    if isOwner then
        MyPanelAccess = true
    else
        local exp = PanelAccess[RealUserId]
        MyPanelAccess = (exp and exp > os.time()) and true or false
    end
end

pcall(loadPanelAccess)

local function givePanelAccess(targetUid, targetName, durationSeconds)
    if not isOwner and not MyPanelAccess then return false end
    local exp = os.time() + durationSeconds
    PanelAccess[targetUid] = exp
    task.spawn(function()
        pcall(function()
            fbReq({
                Url = ACCESS_URL.."/"..tostring(targetUid)..".json",
                Method = "PUT",
                Headers = {["Content-Type"]="application/json"},
                Body = HttpService:JSONEncode({
                    name = targetName,
                    expiresAt = exp,
                    grantedBy = RealUserId,
                    grantedAt = os.time(),
                    duration = durationSeconds,
                })
            })
        end)
    end)
    return true
end

