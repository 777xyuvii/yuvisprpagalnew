local function rawRequest(opts)
    if not opts or not opts.Url then return nil end
    local fn = request or http_request or (http and http.request) or (syn and syn.request) or (fluxus and fluxus.request)
    if not fn then return nil end
    local ok, res = pcall(fn, opts)
    if ok and res then return res end
    return nil
end

