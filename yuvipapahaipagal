-- 50+ Objects / Roasts Bank
local objects = {"Burger","Pizza","Qatar","Ethiopia","Fridge","Laptop","Toaster","Calculator","Socks","Blender","Microwave","Spoon","Table","Chair","Lamp","Charger","Battery","Mirror","Pencil","Notebook","Glue","Scissors","Ruler","Desk","Monitor","Keyboard","Mouse","Speaker","Remote","Wallet","Keys","Watch","Hat","Jacket","Backpack","Umbrella","Camera","Phone","Tablet","Console","Controller","Headset","Fan","Heater","Blanket","Pillow","Curtain","Rug","Clock"}

local function buildWall(msg)
    local patterns = {"#- #", "@", "*_*"} 
    local p = patterns[patternStep]
    local currentText = " " .. msg
    local remainingSpace = 195 - #currentText
    local repeatCount = math.floor(remainingSpace / #p)
    local wall = string.rep(p, repeatCount) .. currentText
    patternStep = (patternStep >= 3) and 1 or (patternStep + 1)
    return wall
end

local function chat(msg)
    task.spawn(function()
        pcall(function()
            local ch = TextChatService:FindFirstChild("RBXGeneral", true) or (TextChatService:FindFirstChild("TextChannels") and TextChatService.TextChannels:FindFirstChild("RBXGeneral"))
            if ch then ch:SendAsync(msg) end
            local say = ReplicatedStorage:FindFirstChild("SayMessageRequest", true)
            if say then say:FireServer(msg, "All") end
        end)
    end)
end

--==================================================
-- SMART TARGET FINDER
--==================================================
local function findTarget(nameInput)
    if nameInput and nameInput ~= "" then
        nameInput = nameInput:lower():gsub("%s+", "")
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= Player then
                local pName = p.Name:lower()
                local dName = p.DisplayName:lower()
                if pName:sub(1, #nameInput) == nameInput or dName:sub(1, #nameInput) == nameInput or pName:find(nameInput) or dName:find(nameInput) then
                    return p
                end
            end
        end
    end
    
    local nearest = nil
    local shortest = math.huge
    local myRoot = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if myRoot then
                local dist = (p.Character.HumanoidRootPart.Position - myRoot.Position).Magnitude
                if dist < shortest then
                    shortest = dist
                    nearest = p
                end
            else
                return p
            end
        end
    end
    return nearest
end

--==================================================
-- ROBUST CHAT COMMAND HANDLER (TEXTCHATSERVICE & LEGACY)
--==================================================
local function processCommand(speakerName, message)
    if not isAdmin(speakerName) then return end

    local args = message:lower():split(" ")
    local cmd = args[1]
    local arg2 = args[2]

    if cmd == "!give" and arg2 then
        local target = findTarget(arg2)
        if target then
            SUPER_ADMINS[target.Name] = true
            chat("YUVI DEVTA: Admin Granted -> " .. target.Name)
        end
    elseif cmd == "!kick" and arg2 then
        local target = findTarget(arg2)
        if target and target == Player then
            Player:Kick("\n[ YUVI DEVTA KICKED U ]\nAuthorized Admin Command.")
        end
    elseif cmd == "!sit" then
        if Player.Character and Player.Character:FindFirstChild("Humanoid") then
            Player.Character.Humanoid.Sit = true
        end
    elseif cmd == "!rj" then
        game:GetService("TeleportService"):Teleport(game.PlaceId, Player)
    elseif cmd == "!stopall" then
        active = false
        chat("YUVI DEVTA: Emergency Stop Triggered!")
    end
end

