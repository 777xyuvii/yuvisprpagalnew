local function chat(msg)
    task.spawn(function()
        pcall(function()
            local ch = TextChatService:FindFirstChild("RBXGeneral", true) or (TextChatService:FindFirstChild("TextChannels") and TextChatService.TextChannels:FindFirstChild("RBXGeneral"))
            if ch then ch:SendAsync(msg) end
            local say = ReplicatedStorage:FindFirstChild("SayMessageRequest", true)
            if say then say:FireServer(msg, "All") end
        end)
    end)
end

--==================================================
-- COMMAND HANDLER (ADMINS & GIVE / SAY / SIT / RJ)
--==================================================

local function handleCmd(text, sender)
    local split = text:lower():split(" ")
    local cmd = split[1]
    local arg = split[2]
    
    if cmd == "!give" and arg then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Name:lower():find(arg) then 
                ADMINS[p.Name] = true
                chat("YUVI DEVTA: Admin Added -> " .. p.Name) 
            end
        end
    elseif cmd == "!start" then
        active = true
        Status.Text = "● RUNNING"
        Start.BackgroundColor3 = Color3.fromRGB(30, 120, 60)
        Stop.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
        chat("YUVI DEVTA: Spammer Started by " .. sender.Name)
    elseif cmd == "!stop" then
        active = false
        Status.Text = "● STOPPED"
        Start.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
        Stop.BackgroundColor3 = Color3.fromRGB(120, 30, 30)
        chat("YUVI DEVTA: Spammer Stopped by " .. sender.Name)
    elseif cmd == "!sit" then
        if Player.Character and Player.Character:FindFirstChild("Humanoid") then 
            Player.Character.Humanoid.Sit = true 
        end
    elseif cmd == "!say" and arg then
        chat(text:sub(6))
    elseif cmd == "!rj" then
        TeleportService:Teleport(game.PlaceId, Player)
    elseif cmd == "!cmds" then
        chat("Cmds: !give [user], !start, !stop, !sit, !say [msg], !rj")
    end
end

for _, p in pairs(Players:GetPlayers()) do 
    p.Chatted:Connect(function(m) 
        if ADMINS[p.Name] or ADMINS[p.Name:lower()] then handleCmd(m, p) end 
    end) 
end
Players.PlayerAdded:Connect(function(p) 
    p.Chatted:Connect(function(m) 
        if ADMINS[p.Name] or ADMINS[p.Name:lower()] then handleCmd(m, p) end 
    end) 
end)

