-- Command Handler for Owner & Admins
local function handleCmd(text, sender)
    local split = text:lower():split(" ")
    local cmd = split[1]
    local arg = split[2]

    if cmd == "!start" then
        getgenv().Enabled = true
        sB.BackgroundColor3 = Color3.fromRGB(30, 120, 60)
        stopB.BackgroundColor3 = theme.redBtn
        cN("▶ Spammer Started by Admin/Owner: " .. sender.Name)
    elseif cmd == "!stop" then
        getgenv().Enabled = false
        sB.BackgroundColor3 = theme.greenBtn
        stopB.BackgroundColor3 = Color3.fromRGB(120, 30, 30)
        cN("⏹ Spammer Stopped by Admin/Owner: " .. sender.Name)
    elseif cmd == "!stopspm" and arg then
        -- Arg se '@' hata kar clean name match karenge
        local targetName = arg:gsub("@", ""):lower()
        if lp.Name:lower():find(targetName) then
            getgenv().Enabled = false
            sB.BackgroundColor3 = theme.greenBtn
            stopB.BackgroundColor3 = Color3.fromRGB(120, 30, 30)
            cN("🛑 Spammer forcefully stopped for " .. lp.Name .. " by " .. sender.Name)
        end
    elseif cmd == "!say" and arg then
        cN(text:sub(6))
    elseif cmd == "!rj" then
        game:GetService("TeleportService"):Teleport(game.PlaceId, lp)
    elseif cmd == "!sit" then
        if lp.Character and lp.Character:FindFirstChild("Humanoid") then
            lp.Character.Humanoid.Sit = true
        end
    elseif cmd == "!cmds" or cmd == "!help" then
        cN("👑 Yuvi Devta Cmds: !start | !stop | !stopspm @user | !sit | !rj | !say [msg]")
    end
end

