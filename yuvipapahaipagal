--==================================================
-- ANTI-FLING ENGINE
--==================================================
local antiFlingActive = false
local MAX_SPEED = 120
local MAX_ANGULAR = 80
local MAX_DISTANCE = 50
local CHECK_INTERVAL = 0.05
local RECOVERY_TIME = 0.40

local safeCFrame
local timer = 0
local recoveryUntil = 0

local function disableCollision(char)
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("BasePart") then
            obj.CanCollide = false
        end
    end
end

local function watchCharacterCollision(char)
    disableCollision(char)
    char.DescendantAdded:Connect(function(obj)
        if obj:IsA("BasePart") and antiFlingActive then
            obj.CanCollide = false
        end
    end)
end

for _, player in ipairs(Players:GetPlayers()) do
    if player ~= Player and player.Character then
        watchCharacterCollision(player.Character)
    end
    player.CharacterAdded:Connect(function(char)
        if player ~= Player then
            watchCharacterCollision(char)
        end
    end)
end

Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(char)
        if player ~= Player and antiFlingActive then
            watchCharacterCollision(char)
        end
    end)
end)

